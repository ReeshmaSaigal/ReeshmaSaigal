@model TourDestinationMVCApp.DTO.DestinationDto

@{
    ViewData["Title"] = "Edit Destination";
}

<h2>Edit Destination</h2>

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    <div class="form-group">
        <label>Name</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger" />
    </div>

    <div class="form-group">
        <label>City</label>
        <input asp-for="City" class="form-control" />
        <span asp-validation-for="City" class="text-danger" />
    </div>

    <div class="form-group">
        <label>Image</label>
            <img src="ImageUrl" class="card-img-top" style="height:150px;object-fit:cover" />
        <input asp-for="ImageFile" type="file" class="form-control-file" />
    </div>

    <button type="submit" class="btn btn-primary">Edit Destination</button>
</form>