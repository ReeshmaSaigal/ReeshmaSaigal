@model TourBookingMVCApplication.DTO.AuthUserDto
@{
    ViewData["Title"] = "Register";
}

<div class="container-fluid d-flex align-items-center justify-content-center mt-5
" style="min-height:100vh; background: linear-gradient(135deg, #6B73FF 0%, #000DFF 100%);">
    <div class="row bg-white shadow-lg rounded-4 overflow-hidden" style="max-width: 950px; width: 100%;">
        <!-- Left section -->
        <div class="col-md-5 p-4 text-white" style="background: url('/images/beach.jpg') center/cover no-repeat;">
            <div class="bg-dark bg-opacity-50 p-4 rounded-4 h-100 d-flex flex-column justify-content-center">
                <h5 class="badge bg-info text-dark mb-2">Featured Package</h5>
                <h2 class="fw-bold">Tropical Beach Paradise</h2>
                <p>7 Days of sun, sand, and unforgettable memories</p>
                <ul class="list-unstyled">
                    <li><i class="bi bi-check-circle text-info"></i> 5-Star Beachfront Resort</li>
                    <li><i class="bi bi-check-circle text-info"></i> All-Inclusive Meals</li>
                    <li><i class="bi bi-check-circle text-info"></i> Water Sports & Activities</li>
                    <li><i class="bi bi-check-circle text-info"></i> Airport Transfers</li>
                </ul>
                <h4 class="fw-bold">$1,299 <span class="text-decoration-line-through text-light fs-6">$1,899</span></h4>
            </div>
        </div>

        <!-- Right section -->
        <div class="col-md-7 p-5">
            <h3 class="fw-bold text-center mb-4 text-primary">Create Your Account</h3>

            <form asp-action="Register" method="post">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">First Name</label>
                        <input asp-for="FirstName" class="form-control" placeholder="John" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Last Name</label>
                        <input asp-for="LastName" class="form-control" placeholder="Doe" required />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Gender</label>
                        <select asp-for="Gender" class="form-select" required>
                            <option value="">Select Gender</option>
                            <option>Male</option>
                            <option>Female</option>
                            <option>Other</option>
                        </select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Date of Birth</label>
                        <input asp-for="DateOfBirth" type="date" class="form-control" required />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Username</label>
                        <input asp-for="UserName" class="form-control" placeholder="johndoe" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Email Address</label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="john@example.com" required />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Phone Number</label>
                        <input asp-for="TelephoneNo" type="text" class="form-control" placeholder="+1 (555) 123-4567" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Password</label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="Create a strong password" required />
                        <small class="text-muted">Must be at least 8 characters long</small>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary w-100 rounded-pill">Sign Up</button>

                <div class="text-center mt-3">
                    <p class="text-muted mb-0">
                        Already have an account?
                        <a asp-action="Login" class="fw-semibold text-primary">Sign In</a>
                    </p>
                </div>
            </form>
        </div>
    </div>
</div>