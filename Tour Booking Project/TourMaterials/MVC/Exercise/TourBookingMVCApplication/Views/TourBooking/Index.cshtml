@model IEnumerable<TourBookingMVCApplication.DTO.TourDto>

@{
    ViewData["Title"] = "Tours & Packages";
    Layout = "~/Views/Shared/_TourLayout.cshtml";
}


<div class="container mt-5">
   
    <!-- Header Section -->
    <div class="d-flex justify-content-end  mb-4">
        <a asp-action="Details" class="btn btn-primary rounded-pill px-3">
            My Booking
        </a>
    </div>
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Tours & Packages</h2>
            <span class="badge bg-info text-dark mt-2">
                @Model.Count() Tours Found
            </span>
        </div>

       
    </div>

    <!-- Table Section -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead style="background-color:#cfd8e6;">
                    <tr>
                        <th>#</th>
                        <th>Title</th>
                        <th>Description</th>
                        <th>Destination</th>
                        <th>Price</th>
                        <th>Status</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @{
                        int count = 1;
                    }

                     @foreach (var item in Model)
                    {
                        <tr>
                            <td>@count</td>
                            <td class="fw-semibold">@item.TourName</td>
                            <td style="max-width:300px;">
                                @item.TourDescription
                            </td>
                            <td>@item.Destination</td>
                            <td class="text-success fw-bold">
                                ₹@item.Price
                            </td>
                            <td>
                                <span class="badge bg-secondary">
                                    @item.Status
                                </span>
                            </td>
                           
                            <td>
                                <a asp-action="Create" asp-route-id="@item.Id" class="btn btn-primary rounded-pill px-3">
                                    BookNow
                                </a>
                            </td>
                        </tr>

                        count++;
                    } 
                </tbody>
            </table>
        </div>
    </div>

</div>