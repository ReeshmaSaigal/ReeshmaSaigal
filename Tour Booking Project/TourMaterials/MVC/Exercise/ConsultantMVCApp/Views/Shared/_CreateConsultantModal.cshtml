

@model ConsultantMVCApp.DTO.CreateConsultantDto

<div class="modal fade" id="addModal">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5>Add New Consultant</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <form asp-action="Create" method="post">
                <div class="modal-body row">

                    <div class="col-md-6 mb-3">
                        <input asp-for="FirstName" class="form-control" placeholder="First Name" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <input asp-for="LastName" class="form-control" placeholder="Last Name" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <input asp-for="Email" class="form-control" placeholder="Email" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <input asp-for="TelephoneNo" class="form-control" placeholder="Phone" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <input asp-for="DateOfBirth" class="form-control" placeholder="Date Of Birth" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <input asp-for="Gender" class="form-control" placeholder="Gender" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <input asp-for="UserName" class="form-control" placeholder="Username" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <input asp-for="Password" type="password" class="form-control" placeholder="Password" />
                    </div>

                </div>

                <div class="modal-footer">
                    <button class="submit btn-primary">Save</button>
                </div>
            </form>

        </div>
    </div>
</div>