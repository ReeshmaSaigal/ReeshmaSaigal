@model IEnumerable< TourDestinationMVCApp.DTO.DestinationResponseDto>

@{
    ViewData["Title"] = "Destinations";
   
    Layout = "_TourLayout";


}

<h2>Destinations</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Add New Destination</a>
</p>

<div class="row">
    @foreach(var destination in Model)
    {
        <div class="col-md-3 mb-3">
            <div class="card">
                @if (!string.IsNullOrEmpty(destination.ImageUrl))
                {
                    <img src="@destination.ImageUrl" class="card-img-top" style="height:150px;object-fit:cover" />
                }
                <div class="card-body">
                    <h5 class="card-title">@destination.Name</h5>
                    <p class="card-text">@destination.City</p>
                    <a asp-action="Details" asp-route-id="@destination.Id" class="btn btn-sm btn-outline-primary">Details</a>
                    <a asp-action="Edit" asp-route-id="@destination.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                    <form method="post" asp-action="Delete" asp-route-id="@destination.Id" style="display:inline" onsubmit="return confirm('Delete?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
