<footer class="bg-dark text-light pt-5 pb-3 mt-5">
    <div class="container">
        <div class="row">

            <!-- Logo Section -->
            <div class="col-md-3 mb-4">
                <div class="d-flex align-items-center mb-3">
                    <img src="~/images/logo.png" alt="Logo" width="60" height="60" class="me-2" />
                </div>
                <p class="small text-muted">
                    Explore the world with us. Your journey begins here.
                </p>
            </div>

            <!-- Quick Links -->
            <div class="col-md-3 mb-4">
                <h6 class="fw-bold mb-3">Quick Links</h6>
                <ul class="list-unstyled">
                    <li><a asp-controller="Destinations" asp-action="Index" class="text-decoration-none text-light">Home</a></li>
                    <li><a asp-controller="Destinations" asp-action="Destinations" class="text-decoration-none text-light">Destinations</a></li>
                    <li><a asp-controller="Destinations" asp-action="Tours" class="text-decoration-none text-light">Tours</a></li>
                    <li><a asp-controller="Destinations" asp-action="Booking" class="text-decoration-none text-light">Booking</a></li>
                </ul>
            </div>

            <!-- Support -->
            <div class="col-md-3 mb-4">
                <h6 class="fw-bold mb-3">Support</h6>
                <ul class="list-unstyled">
                    <li><a asp-controller="Home" asp-action="Faq" class="text-decoration-none text-light">FAQs</a></li>
                    <li><a asp-controller="Home" asp-action="Contact" class="text-decoration-none text-light">Contact</a></li>
                    <li><a asp-controller="Home" asp-action="PrivacyPolicy" class="text-decoration-none text-light">Privacy Policy</a></li>
                    <li><a asp-controller="Home" asp-action="Terms" class="text-decoration-none text-light">Terms</a></li>
                </ul>
            </div>

            <!-- Subscribe -->
            <div class="col-md-3 mb-4">
                <h6 class="fw-bold mb-3">Subscribe</h6>
                <form>
                    <div class="input-group">
                        <input type="email" class="form-control" placeholder="Enter your email" />
                        <button class="btn btn-primary" type="button">Join</button>
                    </div>
                </form>
            </div>

        </div>

        <hr class="border-secondary">

        <!-- Bottom -->
        <div class="d-flex justify-content-between align-items-center">
            <p class="mb-0 small">&copy; @DateTime.Now.Year All rights reserved.</p>

            <div>
                <a href="#" class="text-light me-3"><i class="bi bi-facebook"></i></a>
                <a href="#" class="text-light me-3"><i class="bi bi-instagram"></i></a>
                <a href="#" class="text-light"><i class="bi bi-twitter"></i></a>
            </div>
        </div>
    </div>
</footer>